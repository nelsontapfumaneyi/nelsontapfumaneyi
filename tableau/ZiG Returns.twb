  <worksheets>
    <worksheet name='S1 FX'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>One day in September 2024 decides the whole period: RBZ mid rate, ZiG per US$</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fx_daily' name='federated.fx_daily' />
          </datasources>
          <datasource-dependencies datasource='federated.fx_daily'>
            <column-instance column='[zwg_per_usd]' derivation='Avg' name='[avg:zwg_per_usd:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[date_key]' role='dimension' type='ordinal' />
            <column-instance column='[date_key]' derivation='Day-Trunc' name='[tdy:date_key:qk]' pivot='key' type='quantitative' />
            <column caption='ZiG per US$ (RBZ official mid rate)' datatype='real' name='[zwg_per_usd]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
