    <worksheet name='S3 Spreads'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>Since 2025, the top-rate 3-month index beat the US T-bill; savings did not (pp a year)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='subperiods' name='federated.subperiods' />
          </datasources>
          <datasource-dependencies datasource='federated.subperiods'>
            <column caption='Product' datatype='string' name='[Calculation_instrument_label]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [instrument] WHEN &quot;ZWG_cash&quot; THEN &quot;ZiG cash&quot; WHEN &quot;ZWG_savings_min&quot; THEN &quot;ZiG savings (lowest rate)&quot; WHEN &quot;ZWG_savings_max&quot; THEN &quot;ZiG savings (top rate)&quot; WHEN &quot;ZWG_3m_deposit_min&quot; THEN &quot;ZiG 3-month index (lowest rate)&quot; WHEN &quot;ZWG_3m_deposit_max&quot; THEN &quot;ZiG 3-month index (top rate)&quot; WHEN &quot;ZWG_ZiGDTDF_90d&quot; THEN &quot;RBZ ZiGDTDF 90-day bill&quot; WHEN &quot;USD_cash&quot; THEN &quot;USD cash&quot; WHEN &quot;USD_tbill_3m&quot; THEN &quot;US 3-month T-bill&quot; END' />
            </column>
            <column datatype='string' name='[instrument]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_instrument_label]' derivation='None' name='[none:Calculation_instrument_label:nk]' pivot='key' type='nominal' />
            <column-instance column='[instrument]' derivation='None' name='[none:instrument:nk]' pivot='key' type='nominal' />
            <column-instance column='[subperiod]' derivation='None' name='[none:subperiod:nk]' pivot='key' type='nominal' />
            <column caption='Gap to the US T-bill (percentage points a year)' datatype='real' name='[spread_vs_tbill_ann_pp]' role='measure' type='quantitative' />
            <column caption='Period' datatype='string' name='[subperiod]' role='dimension' type='nominal' />
            <column-instance column='[spread_vs_tbill_ann_pp]' derivation='Sum' name='[sum:spread_vs_tbill_ann_pp:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.subperiods].[none:instrument:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:instrument:nk]' member='&quot;ZWG_cash&quot;' />
              <groupfilter function='member' level='[none:instrument:nk]' member='&quot;ZWG_savings_max&quot;' />
              <groupfilter function='member' level='[none:instrument:nk]' member='&quot;ZWG_3m_deposit_max&quot;' />
              <groupfilter function='member' level='[none:instrument:nk]' member='&quot;ZWG_ZiGDTDF_90d&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.subperiods].[none:subperiod:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:subperiod:nk]' member='&quot;P1 pre-devaluation&quot;' />
              <groupfilter function='member' level='[none:subperiod:nk]' member='&quot;P3 2025&quot;' />
              <groupfilter function='member' level='[none:subperiod:nk]' member='&quot;P4 2026 to Sep&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.subperiods].[none:subperiod:nk]</column>
            <column>[federated.subperiods].[none:instrument:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.subperiods].[none:Calculation_instrument_label:nk]' />
              <text column='[federated.subperiods].[sum:spread_vs_tbill_ann_pp:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.subperiods].[sum:spread_vs_tbill_ann_pp:qk]</rows>
        <cols>([federated.subperiods].[none:subperiod:nk] / [federated.subperiods].[none:Calculation_instrument_label:nk])</cols>
      </table>
      <simple-id uuid='{1632798F-C6B3-452A-B323-A588707E384E}' />
    </worksheet>
    <worksheet name='S4 Break-even'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>ZiG yield needed to match the US T-bill (% a year) by months held</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='scenarios' name='federated.scenarios' />
          </datasources>
          <datasource-dependencies datasource='federated.scenarios'>
            <column caption='Conversion' datatype='string' name='[conversion_case]' role='dimension' type='nominal' />
            <column datatype='string' name='[depreciation_case]' role='dimension' type='nominal' />
            <column caption='Months held' datatype='integer' name='[hold_months]' role='measure' type='quantitative' />
            <column datatype='string' name='[kind]' role='dimension' type='nominal' />
            <column-instance column='[conversion_case]' derivation='None' name='[none:conversion_case:nk]' pivot='key' type='nominal' />
            <column-instance column='[depreciation_case]' derivation='None' name='[none:depreciation_case:nk]' pivot='key' type='nominal' />
            <column-instance column='[hold_months]' derivation='None' name='[none:hold_months:ok]' pivot='key' type='ordinal' />
            <column-instance column='[kind]' derivation='None' name='[none:kind:nk]' pivot='key' type='nominal' />
            <column caption='ZiG yield needed to match the T-bill (% a year)' datatype='real' name='[p50]' role='measure' type='quantitative' />
            <column-instance column='[p50]' derivation='Sum' name='[sum:p50:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.scenarios].[none:depreciation_case:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:depreciation_case:nk]' member='&quot;2026 realised depreciation&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.scenarios].[none:hold_months:ok]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:hold_months:ok]' member='3' />
              <groupfilter function='member' level='[none:hold_months:ok]' member='6' />
              <groupfilter function='member' level='[none:hold_months:ok]' member='12' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.scenarios].[none:kind:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:kind:nk]' member='&quot;required ZiG yield&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.scenarios].[none:kind:nk]</column>
            <column>[federated.scenarios].[none:depreciation_case:nk]</column>
            <column>[federated.scenarios].[none:hold_months:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.scenarios].[none:conversion_case:nk]' />
              <text column='[federated.scenarios].[sum:p50:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.scenarios].[sum:p50:qk]</rows>
        <cols>([federated.scenarios].[none:hold_months:ok] / [federated.scenarios].[none:conversion_case:nk])</cols>
      </table>
      <simple-id uuid='{F20F455D-AF7C-4183-B823-231066716C51}' />
    </worksheet>
    <worksheet name='S5 Loss windows'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>Share of 90-day windows since 2025 that lost US$ value (%)</run>
