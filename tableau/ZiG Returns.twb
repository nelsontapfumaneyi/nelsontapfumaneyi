            <zone h='3423' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4253' />
            <zone h='84440' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='14730'>
              <flipboard active-id='5' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='ZiG cash lost about half its US-dollar value from launch to Sep 2026' captured-sheet='S2 Value' id='1' />
                  <story-point caption='Since 2025, the top-rate 3-month index beat the US T-bill; savings did not' captured-sheet='S3 Spreads' id='2' />
                  <story-point caption='At today&apos;s rates, short conversions do not clear the T-bill hurdle' captured-sheet='S4 Break-even' id='3' />
                  <story-point caption='ZiG cash lost value in far more 90-day windows than the top-rate 3-month index' captured-sheet='S5 Loss windows' id='4' />
                  <story-point caption='Every number, with its source row' captured-sheet='S6 Findings' id='5' />
                </story-points>
              </flipboard>
            </zone>
