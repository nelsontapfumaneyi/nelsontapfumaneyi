        <calculation class='tableau' formula='CASE [instrument] WHEN &quot;ZWG_cash&quot; THEN &quot;ZiG cash&quot; WHEN &quot;ZWG_savings_min&quot; THEN &quot;ZiG savings (lowest rate)&quot; WHEN &quot;ZWG_savings_max&quot; THEN &quot;ZiG savings (top rate)&quot; WHEN &quot;ZWG_3m_deposit_min&quot; THEN &quot;ZiG 3-month index (lowest rate)&quot; WHEN &quot;ZWG_3m_deposit_max&quot; THEN &quot;ZiG 3-month index (top rate)&quot; WHEN &quot;ZWG_ZiGDTDF_90d&quot; THEN &quot;RBZ ZiGDTDF 90-day bill&quot; WHEN &quot;USD_cash&quot; THEN &quot;USD cash&quot; WHEN &quot;USD_tbill_3m&quot; THEN &quot;US 3-month T-bill&quot; END' />
      </column>
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column-instance column='[Calculation_instrument_label]' derivation='None' name='[none:Calculation_instrument_label:nk]' pivot='key' type='nominal' />
<layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
<style-rule element='mark'>
<encoding attr='color' field='[none:Calculation_instrument_label:nk]' type='palette'>
<map to='#d9480f'>
<bucket>&quot;ZiG cash&quot;</bucket>
</map>
<map to='#1e8a55'>
<bucket>&quot;ZiG 3-month index (top rate)&quot;</bucket>
</map>
<map to='#8cc4a3'>
<bucket>&quot;ZiG 3-month index (lowest rate)&quot;</bucket>
</map>
<map to='#6c7a73'>
<bucket>&quot;ZiG savings (top rate)&quot;</bucket>
</map>
<map to='#a3ada8'>
<bucket>&quot;ZiG savings (lowest rate)&quot;</bucket>
</map>
<map to='#7b5ea7'>
<bucket>&quot;RBZ ZiGDTDF 90-day bill&quot;</bucket>
</map>
<map to='#2563b0'>
<bucket>&quot;US 3-month T-bill&quot;</bucket>
</map>
<map to='#a3ada8'>
<bucket>&quot;USD cash&quot;</bucket>
</map>
</encoding>
</style-rule>
</style>
