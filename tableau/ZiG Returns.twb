            <column-instance column='[regime]' derivation='None' name='[none:regime:nk]' pivot='key' type='nominal' />
            <column-instance column='[window_days]' derivation='None' name='[none:window_days:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[regime]' role='dimension' type='nominal' />
            <column caption='Share of 90-day windows with a US$ loss (%)' datatype='real' name='[share_loss_pct]' role='measure' type='quantitative' />
